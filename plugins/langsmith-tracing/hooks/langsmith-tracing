#!/bin/sh
set -eu

RAN_CODES="0"
VERSION="0.6.1"
REPOSITORY="langchain-ai/langsmith-claude-code-plugins"

root="${CLAUDE_PLUGIN_ROOT:-}"
if [ -z "$root" ]; then
  root="$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)"
fi

executable="langsmith-claude-code-tracing"
case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) asset="$executable-darwin-arm64-$VERSION" ;;
  Darwin-x86_64) asset="$executable-darwin-x64-$VERSION" ;;
  *) asset="" ;;
esac

cache="${CLAUDE_PLUGIN_DATA:-}"
preferred=""
alternate=""

download() {
  lock="$cache/bin/.downloading-$asset"
  mkdir "$lock" 2>/dev/null || return 0
  partial="$cache/bin/$asset.partial.$$"
  base="https://github.com/$REPOSITORY/releases/download/$VERSION"
  if curl -fsSL --max-time 300 -o "$partial" "$base/$asset" &&
    expected="$(curl -fsSL --max-time 30 "$base/$asset.sha256" | cut -d' ' -f1)" &&
    [ -n "$expected" ] &&
    [ "$(shasum -a 256 "$partial" | cut -d' ' -f1)" = "$expected" ] &&
    chmod +x "$partial"; then
    mv -f "$partial" "$cache/bin/$asset" || :
  fi
  rm -f "$partial" || :
  rmdir "$lock" || :
}

if [ -n "$cache" ] && [ -n "$asset" ]; then
  preferred="$cache/bin/$asset"
  if [ ! -x "$preferred" ] && mkdir -p "$cache/bin" 2>/dev/null; then
    ( download ) </dev/null >/dev/null 2>&1 &
  fi
fi

ran() {
  case " $RAN_CODES " in
    *" $1 "*) return 0 ;;
  esac
  return 1
}

first=""
for candidate in "$preferred" "$alternate"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    first="$candidate"
    break
  fi
done

if [ -z "$first" ] || ! ( exec 4<&0 ) 2>/dev/null; then
  exec node "$root/bundle/dispatch.js" "$@"
fi

child=""
clean() {
  if [ -n "$child" ]; then kill "$child" 2>/dev/null || :; fi
  rm -f "$event" || :
}

if event="$(mktemp "${TMPDIR:-/tmp}/langsmith-event.XXXXXX" 2>/dev/null)"; then
  trap clean EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 131' QUIT
  trap 'exit 143' TERM
  exec 4<&0
  cat <&4 > "$event" &
  child=$!
  wait "$child"
  child=""
  exec 4<&-
else
  exec node "$root/bundle/dispatch.js" "$@"
fi

unstarted=""
for candidate in "$preferred" "$alternate"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    "$candidate" "$@" < "$event" &
    child=$!
    code=0
    wait "$child" || code=$?
    child=""
    if ran "$code"; then
      exit "$code"
    fi
    unstarted="$candidate exited $code"
  fi
done

( printf '%s\n' "langsmith tracing: carried build did not run ($unstarted); handing the event to node" >&2 ) || :

exec 3< "$event"
rm -f "$event" || :
exec node "$root/bundle/dispatch.js" "$@" <&3
